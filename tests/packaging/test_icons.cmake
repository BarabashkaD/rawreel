# <png> written by sips as an uncompressed TIFF in WORK_DIR and its layout read into
# tiff_<field> variables of the caller: big-endian, 8 bits per sample, 4 samples (RGBA), chunky
# (PlanarConfiguration absent or 1), in strips.
function(read_tiff case png)
    cmake_path(GET png FILENAME name)
    set(tiff "${WORK_DIR}/${name}.tiff")
    execute_process(COMMAND sips -s format tiff "${png}" --out "${tiff}"
                    RESULT_VARIABLE result OUTPUT_QUIET ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        fail("${case}" "sips failed on ${name} (${result}): ${error}")
    endif()
    read_hex("${case}" "${tiff}" 0 4 magic)
    expect_equal("${case}" "${name} TIFF header" "${magic}" "4d4d002a")
    read_be("${case}" "${tiff}" 4 4 ifd)
    read_be("${case}" "${tiff}" ${ifd} 2 entries)
    foreach(field width height compression samples rows_per_strip strip_count strips_at bits
                  bits_at planar)
        set(${field} "")
    endforeach()
    math(EXPR last "${entries} - 1")
    foreach(index RANGE ${last})
        math(EXPR entry "${ifd} + 2 + 12 * ${index}")
        read_be("${case}" "${tiff}" ${entry} 2 tag)
        math(EXPR at "${entry} + 2")
        read_be("${case}" "${tiff}" ${at} 2 type)
        math(EXPR at "${entry} + 4")
        read_be("${case}" "${tiff}" ${at} 4 count)
        math(EXPR at "${entry} + 8")
        if(type EQUAL 3) # SHORT, left-justified in the value field
            read_be("${case}" "${tiff}" ${at} 2 value)
        else()
            read_be("${case}" "${tiff}" ${at} 4 value)
        endif()
        if(tag EQUAL 256)
            set(width ${value})
        elseif(tag EQUAL 257)
            set(height ${value})
        elseif(tag EQUAL 258)
            # BitsPerSample: one SHORT per sample; four do not fit the value field.
            expect_equal("${case}" "${name} BitsPerSample type and count" "${type}/${count}" "3/4")
            read_be("${case}" "${tiff}" ${at} 4 bits_at)
        elseif(tag EQUAL 259)
            set(compression ${value})
        elseif(tag EQUAL 273)
            expect_equal("${case}" "${name} StripOffsets type" "${type}" 4)
            set(strip_count ${count})
            set(strips_at ${value})
            if(count EQUAL 1)
                set(strips_at ${at})
            endif()
        elseif(tag EQUAL 277)
            set(samples ${value})
        elseif(tag EQUAL 278)
            set(rows_per_strip ${value})
        elseif(tag EQUAL 284)
            set(planar ${value})
        endif()
    endforeach()
    expect_equal("${case}" "${name} TIFF size" "${width}x${height}" "1024x1024")
    expect_equal("${case}" "${name} TIFF compression" "${compression}" 1)
    expect_equal("${case}" "${name} TIFF samples" "${samples}" 4)
    if(bits_at STREQUAL "")
        fail("${case}" "${name} TIFF has no BitsPerSample")
    endif()
    foreach(sample 0 1 2 3)
        math(EXPR at "${bits_at} + 2 * ${sample}")
        read_be("${case}" "${tiff}" ${at} 2 sample_bits)
        expect_equal("${case}" "${name} TIFF bits of sample ${sample}" "${sample_bits}" 8)
    endforeach()
    if(NOT planar STREQUAL "" AND NOT planar EQUAL 1)
        fail("${case}" "${name} TIFF PlanarConfiguration is ${planar}, expected 1 (chunky)")
    endif()
    if(rows_per_strip STREQUAL "" OR rows_per_strip GREATER height)
        set(rows_per_strip ${height})
    endif()
    foreach(field file width height rows_per_strip strip_count strips_at)
        set(tiff_${field} "${${field}}" PARENT_SCOPE)
    endforeach()
    set(tiff_file "${tiff}" PARENT_SCOPE)
endfunction()

# The alpha at <x>,<y> of the TIFF read_tiff last read.
function(tiff_alpha case x y out)
    math(EXPR strip "${y} / ${tiff_rows_per_strip}")
    if(strip GREATER_EQUAL tiff_strip_count)
        fail("${case}" "no strip for row ${y}")
    endif()
    math(EXPR at "${tiff_strips_at} + 4 * ${strip}")
    read_be("${case}" "${tiff_file}" ${at} 4 strip_start)
    math(EXPR row "${y} - ${strip} * ${tiff_rows_per_strip}")
    math(EXPR pixel "${strip_start} + (${row} * ${tiff_width} + ${x}) * 4 + 3")
    read_be("${case}" "${tiff_file}" ${pixel} 1 alpha)
    set(${out} ${alpha} PARENT_SCOPE)
endfunction()

# About's logo, transparent-background-1024: 1024 px, 8-bit RGBA. On a macOS host the alpha is
# read from sips' TIFF: 0 at the corners and the edge middles, opaque at the centre. The same
# points tell the variants apart: the square tile is opaque at the corners, the rounded tile at
# the edge middles (checked too, so the points stay meaningful).
set(case "logo")
set(logo "${logo_dir}/transparent-background/owl-on-film-reel-transparent-background-1024.png")
require_file("${case}" "${logo}")
expect_png_header("${case}" "${logo}" 0 1024 1024)
read_hex("${case}" "${logo}" 24 2 depth_and_type)
expect_equal("${case}" "logo bit depth and colour type" "${depth_and_type}" "0806")
if(CMAKE_HOST_APPLE)
    set(corners 0,0 1023,0 0,1023 1023,1023)
    set(edges 0,511 511,0 1023,511 511,1023)
    # The largest alpha at <points> of the TIFF read_tiff last read.
    function(max_alpha case points out)
        set(max 0)
        foreach(point IN LISTS points)
            string(REPLACE "," ";" xy "${point}")
            list(GET xy 0 x)
            list(GET xy 1 y)
            tiff_alpha("${case}" ${x} ${y} alpha)
            if(alpha GREATER max)
                set(max ${alpha})
            endif()
        endforeach()
        set(${out} ${max} PARENT_SCOPE)
    endfunction()
    foreach(variant IN LISTS VARIANTS)
        set(name "owl-on-film-reel-${variant}-background")
        read_tiff("${case}" "${logo_dir}/${variant}-background/${name}-1024.png")
        max_alpha("${case}" "${corners}" corner)
        max_alpha("${case}" "${edges}" edge)
        tiff_alpha("${case}" 511 511 centre)
        if(variant STREQUAL "transparent")
            expect_equal("${case}" "${variant} corner alpha" "${corner}" 0)
            expect_equal("${case}" "${variant} edge-middle alpha" "${edge}" 0)
            if(centre EQUAL 0)
                fail("${case}" "${variant} is transparent at the centre")
            endif()
        elseif(variant STREQUAL "rounded")
            expect_equal("${case}" "${variant} corner alpha" "${corner}" 0)
            if(edge EQUAL 0)
                fail("${case}" "${variant} is transparent at an edge middle")
            endif()
        else()
            if(corner EQUAL 0)
                fail("${case}" "${variant} is transparent at a corner")
            endif()
        endif()
    endforeach()
endif()
pass("${case}")

# --- icns ------------------------------------------------------------------------------------

# The chunk walk: every chunk a PNG stream of the size its type stands for.
set(case "icns")
set(icns "${active}/macOS/${used_name}.icns")
set(icns_types icp4=16 icp5=32 icp6=64 ic07=128 ic08=256 ic09=512 ic10=1024 ic11=32 ic12=64
               ic13=256 ic14=512)
require_file("${case}" "${icns}")
file(SIZE "${icns}" icns_size)
read_hex("${case}" "${icns}" 0 4 magic)
expect_equal("${case}" "magic" "${magic}" "69636e73") # icns
read_be("${case}" "${icns}" 4 4 length)
expect_equal("${case}" "length" "${length}" "${icns_size}")
set(chunks "")
set(offset 8)
while(offset LESS icns_size)
    read_hex("${case}" "${icns}" ${offset} 4 type_hex)
    # The four-character type, decoded from hex (file(READ) without HEX is not byte-exact).
    set(type "")
    foreach(position 0 2 4 6)
        string(SUBSTRING "${type_hex}" ${position} 2 byte)
        math(EXPR code "0x${byte}")
        if(code LESS 32 OR code GREATER 126)
            fail("${case}" "chunk at ${offset} has the type bytes ${type_hex}")
        endif()
        string(ASCII ${code} char)
        string(APPEND type "${char}")
    endforeach()
    math(EXPR at "${offset} + 4")
    read_be("${case}" "${icns}" ${at} 4 chunk_length)
    if(chunk_length LESS 8)
        fail("${case}" "chunk '${type}' at ${offset} has the length ${chunk_length}")
    endif()
    set(size "")
    foreach(item IN LISTS icns_types)
        if(item MATCHES "^${type}=([0-9]+)$")
            set(size ${CMAKE_MATCH_1})
        endif()
    endforeach()
    if(size STREQUAL "")
        fail("${case}" "unexpected chunk '${type}' at ${offset}")
    endif()
    math(EXPR payload "${offset} + 8")
    expect_png_header("${case}" "${icns}" ${payload} ${size} ${size})
    list(APPEND chunks "${type}")
    math(EXPR offset "${offset} + ${chunk_length}")
endwhile()
expect_equal("${case}" "chunk walk end" "${offset}" "${icns_size}")
set(expected "${icns_types}")
list(TRANSFORM expected REPLACE "=.*$" "")
list(SORT expected)
set(sorted "${chunks}")
list(SORT sorted)
expect_equal("${case}" "chunks" "${sorted}" "${expected}")
pass("${case}")


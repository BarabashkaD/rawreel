# Both Windows resource scripts declare the ICO group (the used set's .ico, found through rc.exe's
# /I);
# in rawreel-gui.rc it precedes wx.rc, whose groups (WXICON_*) sort after RAWREEL, so Explorer's
# first group is rawreel's.
set(rc_icon_line "rawreel ICON \"${used_name}.ico\"")
foreach(rc src/gui/rawreel-gui.rc src/cli/rawreel-cli.rc)
    if(NOT EXISTS "${REPO_DIR}/${rc}")
        fail("${case}" "rc icon: ${rc} not found")
    endif()
    file(STRINGS "${REPO_DIR}/${rc}" rc_lines)
    list(TRANSFORM rc_lines STRIP)
    list(FIND rc_lines "${rc_icon_line}" icon_index)
    if(icon_index EQUAL -1)
        fail("${case}" "rc icon: ${rc} lacks the line '${rc_icon_line}'")
    endif()
    if(rc STREQUAL "src/gui/rawreel-gui.rc")
        list(FIND rc_lines "#include \"wx/msw/wx.rc\"" wx_index)
        if(wx_index EQUAL -1 OR wx_index LESS icon_index)
            fail("${case}" "rc icon: ${rc} must declare '${rc_icon_line}' before including wx.rc")
        endif()
    endif()
endforeach()
pass("${case}")

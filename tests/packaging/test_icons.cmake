# Checks the committed icon files of packaging/icons (README.md there): both delivered sets
# (owl-on-film-reel and owl-with-film-frame, three variants each) are complete; the structure of the
# used set's .ico, .icns and PNGs (owl-on-film-reel/square-background); About's logo
# (transparent-background-1024: transparent corners and edge middles); v1's sources.sha256 against
# the files it lists; a privacy scan of every binary; and the files that name the icon.
# Run as cmake -DICONS_DIR=<packaging/icons> -DREPO_DIR=<repository> -DWORK_DIR=<dir>
# -P test_icons.cmake (CTest rawreel.icons). WORK_DIR is emptied first.
# Each case prints "PASS <case>"; the first failed assertion stops the script with
# "FAIL <case>: <why>". ICO and DIB fields are little-endian; icns and PNG fields are big-endian.
cmake_minimum_required(VERSION 3.25)

foreach(var ICONS_DIR REPO_DIR WORK_DIR)
    if(NOT ${var})
        message(FATAL_ERROR "test_icons: ${var} is required")
    endif()
endforeach()
file(REMOVE_RECURSE "${WORK_DIR}")
file(MAKE_DIRECTORY "${WORK_DIR}")

include("${REPO_DIR}/packaging/scan-artifact-privacy.cmake")
# Byte runs of compressed image data that look like an e-mail address (each checked by hand):
# owl-with-film-frame/transparent-background's 1024 px PNG and the .icns that holds the same PNG
# stream.
list(APPEND RAWREEL_PRIVACY_EMAIL_ALLOW "A@r.ml") # privacy-lint: allow

# --- helpers ---------------------------------------------------------------------------------

function(fail case why)
    message(FATAL_ERROR "FAIL ${case}: ${why}")
endfunction()

function(pass case)
    message(STATUS "PASS ${case}")
endfunction()

function(expect_equal case what actual expected)
    if(NOT "${actual}" STREQUAL "${expected}")
        fail("${case}" "${what} is '${actual}', expected '${expected}'")
    endif()
endfunction()

function(require_file case file)
    if(NOT EXISTS "${file}")
        cmake_path(GET file FILENAME name)
        fail("${case}" "${name} not found")
    endif()
endfunction()

# <count> bytes at <offset> as lower-case hex; fails when the file ends before them.
function(read_hex case file offset count out)
    file(READ "${file}" hex OFFSET ${offset} LIMIT ${count} HEX)
    string(LENGTH "${hex}" length)
    math(EXPR wanted "2 * ${count}")
    if(NOT length EQUAL wanted)
        cmake_path(GET file FILENAME name)
        fail("${case}" "${name} ends before byte ${offset} + ${count}")
    endif()
    set(${out} "${hex}" PARENT_SCOPE)
endfunction()

# An unsigned big-endian integer of <count> bytes at <offset>.
function(read_be case file offset count out)
    read_hex("${case}" "${file}" ${offset} ${count} hex)
    math(EXPR value "0x${hex}")
    set(${out} ${value} PARENT_SCOPE)
endfunction()

# An unsigned little-endian integer of <count> bytes at <offset>.
function(read_le case file offset count out)
    read_hex("${case}" "${file}" ${offset} ${count} hex)
    set(reversed "")
    math(EXPR last "${count} - 1")
    foreach(index RANGE ${last})
        math(EXPR position "2 * (${last} - ${index})")
        string(SUBSTRING "${hex}" ${position} 2 byte)
        string(APPEND reversed "${byte}")
    endforeach()
    math(EXPR value "0x${reversed}")
    set(${out} ${value} PARENT_SCOPE)
endfunction()

set(PNG_SIGNATURE "89504e470d0a1a0a")
set(ARGB_HEX "41524742")

# A PNG stream at <offset>: the signature, then IHDR with <width> x <height>.
function(expect_png_header case file offset width height)
    cmake_path(GET file FILENAME name)
    read_hex("${case}" "${file}" ${offset} 8 signature)
    expect_equal("${case}" "${name} signature at ${offset}" "${signature}" "${PNG_SIGNATURE}")
    math(EXPR chunk "${offset} + 12")
    read_hex("${case}" "${file}" ${chunk} 4 type)
    expect_equal("${case}" "${name} first chunk" "${type}" "49484452") # IHDR
    math(EXPR at "${offset} + 16")
    read_be("${case}" "${file}" ${at} 4 actual_width)
    math(EXPR at "${offset} + 20")
    read_be("${case}" "${file}" ${at} 4 actual_height)
    expect_equal("${case}" "${name} IHDR size" "${actual_width}x${actual_height}"
                 "${width}x${height}")
endfunction()

# The relative paths of the files under <dir> matching <pattern>, sorted; hidden files (such as the
# Finder's .DS_Store) are skipped, as v1/tools/render-icons.swift skips them.
function(list_files dir pattern out)
    file(GLOB files RELATIVE "${dir}" "${dir}/${pattern}")
    list(FILTER files EXCLUDE REGEX "(^|/)\\.")
    list(SORT files)
    set(${out} "${files}" PARENT_SCOPE)
endfunction()

# Every file under <dir>, relative and sorted; hidden files are skipped.
function(list_tree dir out)
    file(GLOB_RECURSE files RELATIVE "${dir}" "${dir}/*")
    list(FILTER files EXCLUDE REGEX "(^|/)\\.")
    list(SORT files)
    set(${out} "${files}" PARENT_SCOPE)
endfunction()


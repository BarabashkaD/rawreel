# Each image is a PNG stream or a 32-bit DIB (BITMAPINFOHEADER, BGRA rows and the AND mask).
set(case "ico entries")
set(seen "")
math(EXPR last_entry "${ico_count} - 1")
foreach(index RANGE ${last_entry})
    math(EXPR entry "6 + 16 * ${index}")
    read_le("${case}" "${ico}" ${entry} 1 width)
    math(EXPR at "${entry} + 1")
    read_le("${case}" "${ico}" ${at} 1 height)
    math(EXPR at "${entry} + 4")
    read_le("${case}" "${ico}" ${at} 2 planes)
    math(EXPR at "${entry} + 6")
    read_le("${case}" "${ico}" ${at} 2 bits)
    math(EXPR at "${entry} + 8")
    read_le("${case}" "${ico}" ${at} 4 bytes)
    math(EXPR at "${entry} + 12")
    read_le("${case}" "${ico}" ${at} 4 offset)
    if(width EQUAL 0)
        set(width 256)
    endif()
    if(height EQUAL 0)
        set(height 256)
    endif()
    expect_equal("${case}" "entry ${index} height" "${height}" "${width}")
    expect_equal("${case}" "entry ${index} planes" "${planes}" 1)
    expect_equal("${case}" "entry ${index} bit count" "${bits}" 32)
    math(EXPR end "${offset} + ${bytes}")
    if(end GREATER ico_size OR offset LESS 6)
        fail("${case}" "entry ${index} (${offset} + ${bytes}) lies outside the ${ico_size} bytes")
    endif()
    read_hex("${case}" "${ico}" ${offset} 8 start)
    if(start STREQUAL PNG_SIGNATURE)
        expect_png_header("${case}" "${ico}" ${offset} ${width} ${height})
    else()
        read_le("${case}" "${ico}" ${offset} 4 header_size)
        math(EXPR at "${offset} + 4")
        read_le("${case}" "${ico}" ${at} 4 dib_width)
        math(EXPR at "${offset} + 8")
        read_le("${case}" "${ico}" ${at} 4 dib_height)
        math(EXPR at "${offset} + 14")
        read_le("${case}" "${ico}" ${at} 2 dib_bits)
        expect_equal("${case}" "entry ${index} BITMAPINFOHEADER size" "${header_size}" 40)
        expect_equal("${case}" "entry ${index} biWidth" "${dib_width}" "${width}")
        math(EXPR twice "2 * ${width}")
        expect_equal("${case}" "entry ${index} biHeight" "${dib_height}" "${twice}")
        expect_equal("${case}" "entry ${index} biBitCount" "${dib_bits}" 32)
        math(EXPR expected "40 + 4 * ${width} * ${width} + ((${width} + 31) / 32) * 4 * ${width}")
        expect_equal("${case}" "entry ${index} size" "${bytes}" "${expected}")
    endif()
    list(APPEND seen ${width})
endforeach()
list(SORT seen COMPARE NATURAL)
expect_equal("${case}" "sizes" "${seen}" "${ico_sizes}")
pass("${case}")

# --- PNGs ------------------------------------------------------------------------------------


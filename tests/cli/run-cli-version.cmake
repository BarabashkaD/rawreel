# rawreel-cli --version (M4 Task 7a; design D21, D23): every package, the Vulkan line and the
# FFmpeg status line, as text and as JSON. Needs -DVERSION=<rawreel's version>.
include("${CMAKE_CURRENT_LIST_DIR}/cli_common.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/cli_ffmpeg_common.cmake")
if(NOT VERSION)
    message(FATAL_ERROR "run with -DVERSION=<rawreel version>")
endif()

require_ffmpeg()

run_cli(0 out err --version)
string(REGEX MATCH "^[^\n]*" first_line "${out}")
if(NOT first_line STREQUAL "rawreel ${VERSION}")
    message(FATAL_ERROR "--version: first line '${first_line}', expected 'rawreel ${VERSION}'")
endif()
string(REPLACE "\n" ";" lines "${out}")
set(vulkan_line "")
set(ffmpeg_line "")
foreach(line IN LISTS lines)
    if(line MATCHES "^Vulkan: ")
        set(vulkan_line "${line}")
    elseif(line MATCHES "^FFmpeg n8\\.1\\.3 \\(LGPL")
        set(ffmpeg_line "${line}")
    endif()
endforeach()
if(NOT vulkan_line)
    message(FATAL_ERROR "--version: no 'Vulkan: ' line in:\n${out}")
endif()
if(NOT ffmpeg_line)
    message(FATAL_ERROR "--version: no 'FFmpeg n8.1.3 (LGPL' line in:\n${out}")
endif()

run_cli(0 out err --version --json)
foreach(key IN ITEMS rawreel dvv_components wxwidgets vulkan ffmpeg)
    string(JSON value ERROR_VARIABLE missing GET "${out}" ${key})
    if(missing)
        message(FATAL_ERROR "--version --json: ${missing}\n${out}")
    endif()
endforeach()
expect_json("${out}" "${VERSION}" rawreel)

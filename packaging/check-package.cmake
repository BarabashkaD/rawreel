function(rawreel_readelf_dynamic)
    cmake_parse_arguments(PARSE_ARGV 0 arg "" "TEXT;NEEDED;SONAME;RUNPATH;RPATH" "")
    _rawreel_text_lines("${arg_TEXT}" lines)
    set(needed "")
    set(soname "")
    set(runpath "")
    set(rpath "")
    foreach(line IN LISTS lines)
        _rawreel_line_decode("${line}" line)
        if(line MATCHES "\\(NEEDED\\) +Shared library: \\[(.*)\\] *$")
            list(APPEND needed "${CMAKE_MATCH_1}")
        elseif(line MATCHES "\\(SONAME\\) +Library soname: \\[(.*)\\] *$")
            set(soname "${CMAKE_MATCH_1}")
        elseif(line MATCHES "\\(RUNPATH\\) +Library runpath: \\[(.*)\\] *$")
            set(runpath "${CMAKE_MATCH_1}")
        elseif(line MATCHES "\\(RPATH\\) +Library rpath: \\[(.*)\\] *$")
            set(rpath "${CMAKE_MATCH_1}")
        endif()
    endforeach()
    set(${arg_NEEDED} "${needed}" PARENT_SCOPE)
    set(${arg_SONAME} "${soname}" PARENT_SCOPE)
    set(${arg_RUNPATH} "${runpath}" PARENT_SCOPE)
    set(${arg_RPATH} "${rpath}" PARENT_SCOPE)
endfunction()

function(rawreel_readelf_max_versions)
    cmake_parse_arguments(PARSE_ARGV 0 arg "" "TEXT;GLIBC;GLIBCXX" "")
    foreach(prefix IN ITEMS GLIBC GLIBCXX)
        set(highest "")
        string(REGEX MATCHALL "${prefix}_[0-9]+(\\.[0-9]+)*" found "${arg_TEXT}")
        foreach(item IN LISTS found)
            string(REGEX REPLACE "^${prefix}_" "" version "${item}")
            if(highest STREQUAL "" OR version VERSION_GREATER highest)
                set(highest "${version}")
            endif()
        endforeach()
        set(${arg_${prefix}} "${highest}" PARENT_SCOPE)
    endforeach()
endfunction()

function(rawreel_elf_errors)
    cmake_parse_arguments(PARSE_ARGV 0 arg ""
                          "NAME;KIND;DYNAMIC;VERSIONS;GLIBC_MAX;GLIBCXX_MAX;ERRORS" "ALLOWED")
    rawreel_readelf_dynamic(TEXT "${arg_DYNAMIC}" NEEDED needed SONAME soname RUNPATH runpath
                            RPATH rpath)
    set(errors "")
    if(arg_KIND STREQUAL "exe")
        foreach(kind IN ITEMS RUNPATH RPATH)
            string(TOLOWER "${kind}" variable)
            if(NOT "${${variable}}" STREQUAL "")
                list(APPEND errors "${arg_NAME} has ${kind} ${${variable}} (the exes need none)")
            endif()
        endforeach()
        foreach(library IN LISTS needed)
            if(library MATCHES
               "^lib(avutil|avcodec|avformat|avfilter|avdevice|swscale|swresample|postproc)\\.so")
                string(CONCAT error "${arg_NAME} links the FFmpeg library ${library} (FFmpeg is "
                                    "loaded at run time)")
                list(APPEND errors "${error}")
            elseif(NOT library IN_LIST arg_ALLOWED)
                list(APPEND errors "${arg_NAME} needs ${library}, which is not in the system list")
            endif()
        endforeach()
    elseif(arg_KIND STREQUAL "library")
        if(NOT runpath STREQUAL "$ORIGIN")
            list(APPEND errors "${arg_NAME} has RUNPATH '${runpath}', expected exactly $ORIGIN")
        endif()
        if(NOT rpath STREQUAL "")
            list(APPEND errors "${arg_NAME} has RPATH ${rpath} (expected only RUNPATH $ORIGIN)")
        endif()
        if(soname STREQUAL "")
            list(APPEND errors "${arg_NAME} has no SONAME")
        elseif(NOT soname STREQUAL arg_NAME)
            list(APPEND errors "${arg_NAME} is not named by its SONAME ${soname}")
        endif()
    else()
        message(FATAL_ERROR "rawreel_elf_errors: KIND must be exe or library")
    endif()
    rawreel_readelf_max_versions(TEXT "${arg_VERSIONS}" GLIBC glibc GLIBCXX glibcxx)
    if(NOT glibc STREQUAL "" AND glibc VERSION_GREATER arg_GLIBC_MAX)
        list(APPEND errors "${arg_NAME} needs GLIBC_${glibc}, the baseline is ${arg_GLIBC_MAX}")
    endif()
    if(NOT glibcxx STREQUAL "" AND glibcxx VERSION_GREATER arg_GLIBCXX_MAX)
        list(APPEND errors "${arg_NAME} needs GLIBCXX_${glibcxx}, the baseline is ${arg_GLIBCXX_MAX}")
    endif()
    set(${arg_ERRORS} "${errors}" PARENT_SCOPE)
endfunction()

function(rawreel_ldd_errors)

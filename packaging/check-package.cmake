function(rawreel_readelf_debuglink)
    cmake_parse_arguments(PARSE_ARGV 0 arg "" "TEXT;NAME" "")
    _rawreel_text_lines("${arg_TEXT}" lines)
    set(name "")
    set(in_dump OFF)
    foreach(line IN LISTS lines)
        _rawreel_line_decode("${line}" line)
        if(line MATCHES "^String dump of section '\\.gnu_debuglink':")
            set(in_dump ON)
        elseif(in_dump AND line MATCHES "^ *\\[ *0\\] +([^ ]+)")

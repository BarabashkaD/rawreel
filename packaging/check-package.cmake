# Package checks (design M4 v2 §8.6, D16, D20), used by package-smoke.cmake and
# verify-ffmpeg-archive.cmake; unit-tested by tests/packaging/test_packaging_scripts.cmake.
#
#   rawreel_check_manifest(ROOT <dir> MANIFEST <file> VERSION <v> BUNDLED <bool>
#                          ERRORS <var> [CLASSES <var>])
#     Every file under ROOT matches exactly one applicable manifest line and every applicable line
#     exactly one file. ERRORS receives one message per problem (empty list = pass); CLASSES
#     receives "<kind>|<relative path>" for every file ("unexpected|<path>" for a file no line
#     names).
#   rawreel_check_notices(FILE <notices file> SHIPPED <name>... ERRORS <var>)
#     The notice entries (names) equal SHIPPED exactly; the Visual C++ runtime paragraph is absent
#     (the zip ships no VC++ runtime).
#   rawreel_strip_msvc_notice(IN <notices file> OUT <file>)
#     Writes IN without its Visual C++ runtime paragraph (the last one when present).
#   rawreel_vc_runtime_files(ROOT <dir> FILES <var>)
#     The paths below ROOT of VC++ runtime DLLs ((vcruntime|msvcp|concrt|vccorlib)140*.dll, any
#     case); the zip ships none.
#   rawreel_redist_minimum_errors(MINIMUM <14.x> [MSVC_VERSION <cl version>] DOCS <file>...
#                                 ERRORS <var>)
#     The minimum VC++ Redistributable users must install (Microsoft: at least as recent
#     as the build tools): a 14.<minor> version not older than the toolset of cl 19.<minor> (when
#     MSVC_VERSION is given), and
#     named in every DOCS file as "Redistributable (x64) <MINIMUM> or newer".
#   rawreel_apt_packages_doc_errors(PACKAGES <package>... DOCS <file>... ERRORS <var>)
#     Every DOCS file names the Linux package's system packages in one line,
#     "sudo apt install <PACKAGES joined by spaces>".
#   rawreel_check_pdb_reference(FILE <exe> ERRORS <var>)
#     Every string ending in ".pdb" in the exe is a bare file name (no '/', '\' or ':').
#   rawreel_attestation_source(JSON <text> COMMIT <var> REF <var> ERRORS <var>)
#     From `gh attestation verify --format json` output: element 0's
#     verificationResult.signature.certificate.sourceRepositoryDigest and .sourceRepositoryRef.
#   rawreel_ffmpeg_version_line(TEXT <rawreel-cli --version output> LINE <var> ERRORS <var>)
#     The output must hold exactly one line starting with "FFmpeg"; LINE receives it (without CR).
#   rawreel_licence_supplements(DIR <dir> SUPPLEMENTS <path|sha256>... PATHS <var> ERRORS <var>)
#     Each supplement file <dir>/<path> exists and its SHA256 equals its pin (the
#     pinned files are shipped as they are). PATHS receives the paths.
#   rawreel_work_dir_errors(DIR <dir> PROTECT <path>... ERRORS <var>)
#     A folder a script may delete as a whole: not a filesystem root and not equal to or an
#     ancestor of any PROTECT path (compared case-insensitively on Windows).
#   rawreel_package_files(VERSION <v> PLATFORM <windows|linux> PACKAGE <var> SYMBOLS <var>
#                         CPACK <var> EXTENSION <var> GENERATOR <var> ERRORS <var>)
#     The file names of a platform's package (rawreel-<v>-<platform>-x64.<ext>), its symbols
#     archive (-symbols.zip on Windows, -symbols.tar.xz on Linux) and CPack's output before the
#     rename (rawreel-<v>.<ext>); the extension (zip, tar.xz) and the CPack generator (ZIP, TXZ).
#     Any other platform is an error and every name is empty.
#   rawreel_ffmpeg_library_pattern(PLATFORM <windows|linux> LIBRARY <name> GLOB <var> REGEX <var>)
#     The FFmpeg library file the loader opens (dvv-components checks.cpp): <name>-<major>.dll on
#     Windows, lib<name>.so.<major> (the SONAME) on Linux. GLOB finds the candidates in a folder;
#     REGEX matches only that file in a path and captures <major> as CMAKE_MATCH_1.
#
# Linux ELF checks (pure: they read the text that readelf and ldd print, so they run on Windows):
#   rawreel_is_elf(FILE <file> RESULT <var>)
#     ON when the file starts with the ELF magic (7f 'E' 'L' 'F'); the Linux exes have no extension.
#   rawreel_readelf_dynamic(TEXT <readelf -d> NEEDED <var> SONAME <var> RUNPATH <var> RPATH <var>)
#   rawreel_readelf_max_versions(TEXT <readelf -V> GLIBC <var> GLIBCXX <var>)
#     The highest GLIBC_<v> and GLIBCXX_<v> named (compared as versions); empty when none.
#   rawreel_elf_errors(NAME <file name> KIND exe|library DYNAMIC <readelf -d> VERSIONS <readelf -V>
#                      ALLOWED <soname>... GLIBC_MAX <v> GLIBCXX_MAX <v> ERRORS <var>)
#     exe: no RUNPATH or RPATH, every NEEDED soname in ALLOWED and none an FFmpeg library (FFmpeg
#     is loaded at run time from ffmpeg/). library: RUNPATH exactly $ORIGIN, no RPATH, the file is
#     named by its SONAME. Both: the highest GLIBC_/GLIBCXX_ versions are not above the maxima.
#   rawreel_ldd_errors(NAME <file name> TEXT <ldd output> ERRORS <var>)
#     One error per "not found" line.
#   rawreel_linux_runtime_files(ROOT <dir> FILES <var>)
#     The paths below ROOT of C/C++ runtime or Vulkan loader libraries (libstdc++, libgcc_s, libc,
#     libvulkan) and of any other shared library outside <top>/ffmpeg/; the tar ships none.
#   rawreel_readelf_build_id(TEXT <readelf -n> ID <var>)
#   rawreel_readelf_debuglink(TEXT <readelf -p .gnu_debuglink> NAME <var>)
#   rawreel_readelf_compressed_sections(TEXT <readelf -S -W> SECTIONS <var>)
#     The sections whose flags hold C (compressed); the .debug files must have none, so the
#     privacy scan can read them.
#
# Manifest format: "<kind> <path> [<sha256>]" per line, "#" comments, path relative to the archive
# root, "@V@" = the version. Kinds: ours (built here), ours-bundled (only when bundled), notices,
# ffmpeg (a bundled third-party file with its SHA256; only when bundled). Lines that do not apply
# to the variant are ignored, so their files count as unexpected.
include_guard(GLOBAL)

# Lines of a text file as a list whose items cannot break CMake's list handling: '\', ';', '[' and
# ']' are replaced by control characters (_rawreel_line_decode restores them).
function(_rawreel_read_lines file out)
    file(READ "${file}" content)
    _rawreel_text_lines("${content}" lines)
    set(${out} "${lines}" PARENT_SCOPE)
endfunction()

function(_rawreel_text_lines content out)
    string(ASCII 1 c1)
    string(ASCII 2 c2)
    string(ASCII 3 c3)
    string(ASCII 4 c4)
    string(REPLACE "\\" "${c1}" content "${content}")
    string(REPLACE ";" "${c2}" content "${content}")
    string(REPLACE "[" "${c3}" content "${content}")
    string(REPLACE "]" "${c4}" content "${content}")
    string(REPLACE "\r" "" content "${content}")
    string(REPLACE "\n" ";" lines "${content}")
    set(${out} "${lines}" PARENT_SCOPE)
endfunction()

function(_rawreel_line_decode line out)
    string(ASCII 1 c1)
    string(ASCII 2 c2)
    string(ASCII 3 c3)
    string(ASCII 4 c4)
    string(REPLACE "${c1}" "\\" line "${line}")
    string(REPLACE "${c2}" ";" line "${line}")
    string(REPLACE "${c3}" "[" line "${line}")
    string(REPLACE "${c4}" "]" line "${line}")
    set(${out} "${line}" PARENT_SCOPE)
endfunction()

# Parses a notices file in the format of rawreel-workspace/deps/write-notices.cmake. A separator is
# a line of at least 20 '='. An entry is a separator whose next line is "<name> <version>" and whose
# line after that starts with "Licence:"; the Visual C++ runtime paragraph is a separator followed
# by exactly "Microsoft Visual C++ runtime". Any other separator (a long '=' underline inside a
# licence text) is ignored. A licence block runs from a line "--- <path> ---" to the next entry,
# the runtime paragraph or the end of the file. ENTRIES receives the entry names, MSVC whether the
# paragraph is present, OUTSIDE the (encoded) lines outside the licence blocks.
function(_rawreel_notices_parse file out_entries out_msvc out_outside)
    _rawreel_read_lines("${file}" lines)
    string(ASCII 5 end)
    list(APPEND lines "${end}" "${end}")
    set(separator "^====================+$")
    set(entries "")
    set(msvc OFF)
    set(outside "")
    set(in_block OFF)
    set(index 0)
    set(a "")
    set(b "")
    # Each line (a) is classified when the two lines after it (b, c) are known.
    foreach(c IN LISTS lines)
        if(index GREATER_EQUAL 2)
            if(a MATCHES "${separator}" AND b STREQUAL "Microsoft Visual C++ runtime")
                set(in_block OFF)
                set(msvc ON)
            elseif(a MATCHES "${separator}" AND b MATCHES "^([^ ]+) [^ ]")
                set(name "${CMAKE_MATCH_1}")
                if(c MATCHES "^Licence:")
                    set(in_block OFF)
                    list(APPEND entries "${name}")
                endif()
            elseif(a MATCHES "^--- .+ ---$")
                set(in_block ON)
            endif()
            if(NOT in_block)
                list(APPEND outside "${a}")
            endif()
        endif()
        set(a "${b}")
        set(b "${c}")
        math(EXPR index "${index} + 1")
    endforeach()
    set(${out_entries} "${entries}" PARENT_SCOPE)
    set(${out_msvc} ${msvc} PARENT_SCOPE)
    set(${out_outside} "${outside}" PARENT_SCOPE)
endfunction()

function(rawreel_check_manifest)
    cmake_parse_arguments(PARSE_ARGV 0 arg "" "ROOT;MANIFEST;VERSION;BUNDLED;ERRORS;CLASSES" "")
    foreach(required IN ITEMS ROOT MANIFEST VERSION ERRORS)
        if(NOT DEFINED arg_${required})
            message(FATAL_ERROR "rawreel_check_manifest: ${required} is required")
        endif()
    endforeach()
    set(errors "")
    set(paths "")
    set(kinds "")
    set(hashes "")
    # Read line by line with ';', '[', ']' and '\' encoded: a comment may hold any of them.
    _rawreel_read_lines("${arg_MANIFEST}" manifest_lines)
    foreach(line IN LISTS manifest_lines)
        _rawreel_line_decode("${line}" line)
        string(STRIP "${line}" line)
        if(line STREQUAL "" OR line MATCHES "^#")
            continue()
        endif()
        if(NOT line MATCHES "^(ours|ours-bundled|notices|ffmpeg) +([^ ]+)( +([0-9a-fA-F]+))?$")
            list(APPEND errors "bad manifest line: ${line}")
            continue()
        endif()
        set(kind "${CMAKE_MATCH_1}")
        set(path "${CMAKE_MATCH_2}")
        string(TOLOWER "${CMAKE_MATCH_4}" hash)
        string(LENGTH "${hash}" hash_length)
        if(kind STREQUAL "ffmpeg" AND NOT hash_length EQUAL 64)
            list(APPEND errors "bad manifest line (ffmpeg needs a SHA256): ${line}")
            continue()
        endif()
        if(kind MATCHES "^(ours-bundled|ffmpeg)$" AND NOT arg_BUNDLED)
            continue()
        endif()
        string(REPLACE "@V@" "${arg_VERSION}" path "${path}")
        if(path IN_LIST paths)
            list(APPEND errors "bad manifest line (duplicate path): ${line}")
            continue()
        endif()
        list(APPEND paths "${path}")
        list(APPEND kinds "${kind}")
        if(hash STREQUAL "")
            set(hash "-")
        endif()
        list(APPEND hashes "${hash}")
    endforeach()

    file(GLOB_RECURSE files LIST_DIRECTORIES false RELATIVE "${arg_ROOT}" "${arg_ROOT}/*")
    list(SORT files)
    set(classes "")
    foreach(file IN LISTS files)
        list(FIND paths "${file}" index)
        if(index EQUAL -1)
            list(APPEND errors "unexpected file ${file}")
            list(APPEND classes "unexpected|${file}")
            continue()
        endif()
        list(GET kinds ${index} kind)
        list(GET hashes ${index} hash)
        list(APPEND classes "${kind}|${file}")
        if(NOT hash STREQUAL "-")
            file(SHA256 "${arg_ROOT}/${file}" actual)
            if(NOT actual STREQUAL hash)
                list(APPEND errors "SHA256 mismatch ${file}")
            endif()
        endif()
    endforeach()
    foreach(path IN LISTS paths)
        if(NOT path IN_LIST files)
            list(APPEND errors "missing file ${path}")
        endif()
    endforeach()
    set(${arg_ERRORS} "${errors}" PARENT_SCOPE)
    if(DEFINED arg_CLASSES)
        set(${arg_CLASSES} "${classes}" PARENT_SCOPE)
    endif()
endfunction()

function(rawreel_check_notices)
    cmake_parse_arguments(PARSE_ARGV 0 arg "" "FILE;ERRORS" "SHIPPED")
    if(NOT EXISTS "${arg_FILE}")
        message(FATAL_ERROR "rawreel_check_notices: ${arg_FILE} does not exist")
    endif()
    _rawreel_notices_parse("${arg_FILE}" entries msvc outside)
    set(errors "")
    foreach(name IN LISTS arg_SHIPPED)
        if(NOT name IN_LIST entries)
            list(APPEND errors "missing notice ${name}")
        endif()
    endforeach()
    list(REMOVE_DUPLICATES entries)
    foreach(name IN LISTS entries)
        if(NOT name IN_LIST arg_SHIPPED)
            list(APPEND errors "unexpected notice ${name}")
        endif()
    endforeach()
    if(msvc)
        list(APPEND errors "unexpected notice Microsoft Visual C++ runtime")
    endif()
    set(${arg_ERRORS} "${errors}" PARENT_SCOPE)
endfunction()

function(rawreel_strip_msvc_notice)
    cmake_parse_arguments(PARSE_ARGV 0 arg "" "IN;OUT" "")
    file(READ "${arg_IN}" content)
    # rawreel-workspace's write-notices.cmake appends the paragraph last, so it runs to the end.
    string(REGEX MATCH "\n=+\nMicrosoft Visual C\\+\\+ runtime\n" head "${content}")
    if(NOT head STREQUAL "")
        string(FIND "${content}" "${head}" position)
        string(SUBSTRING "${content}" ${position} -1 tail)
        string(LENGTH "${head}" head_length)
        string(SUBSTRING "${tail}" ${head_length} -1 rest)
        if(rest MATCHES "(^|\n)====================+\n")
            message(FATAL_ERROR "rawreel_strip_msvc_notice: ${arg_IN}: the Visual C++ runtime "
                                "paragraph is not the last one")
        endif()
        string(SUBSTRING "${content}" 0 ${position} content)
    endif()
    file(WRITE "${arg_OUT}" "${content}")
endfunction()

function(rawreel_vc_runtime_files)
    cmake_parse_arguments(PARSE_ARGV 0 arg "" "ROOT;FILES" "")
    file(GLOB_RECURSE files LIST_DIRECTORIES false RELATIVE "${arg_ROOT}" "${arg_ROOT}/*")
    set(found "")
    foreach(file IN LISTS files)
        cmake_path(GET file FILENAME name)
        string(TOLOWER "${name}" lower)
        if(lower MATCHES "^(vcruntime|msvcp|concrt|vccorlib)140.*\\.dll$")
            list(APPEND found "${file}")
        endif()
    endforeach()
    list(SORT found)
    set(${arg_FILES} "${found}" PARENT_SCOPE)
endfunction()

function(rawreel_redist_minimum_errors)
    cmake_parse_arguments(PARSE_ARGV 0 arg "" "MINIMUM;MSVC_VERSION;ERRORS" "DOCS")
    set(errors "")
    if(NOT arg_MINIMUM MATCHES "^14\\.[0-9]+$")
        list(APPEND errors "the minimum VC++ Redistributable ${arg_MINIMUM} is no 14.<minor> version")
    endif()
    # cl 19.<minor> belongs to the build tools (toolset) 14.<minor> since Visual Studio 2017.
    if(DEFINED arg_MSVC_VERSION)
        if(arg_MSVC_VERSION MATCHES "^19\\.([0-9]+)")
            set(tools "14.${CMAKE_MATCH_1}")
            if(tools VERSION_GREATER arg_MINIMUM)
                string(CONCAT error "the build tools ${tools} are newer than the minimum VC++ "
                                    "Redistributable ${arg_MINIMUM}")
                list(APPEND errors "${error}")
            endif()
        else()
            list(APPEND errors "the MSVC version ${arg_MSVC_VERSION} is no 19.<minor> version")
        endif()
    endif()
    set(phrase "Redistributable (x64) ${arg_MINIMUM} or newer")
    foreach(doc IN LISTS arg_DOCS)
        cmake_path(GET doc FILENAME name)
        if(NOT EXISTS "${doc}")
            list(APPEND errors "${name} is missing")
            continue()
        endif()
        file(READ "${doc}" text)
        string(FIND "${text}" "${phrase}" position)
        if(position EQUAL -1)
            list(APPEND errors "${name} does not say \"${phrase}\"")
        endif()
    endforeach()
    set(${arg_ERRORS} "${errors}" PARENT_SCOPE)
endfunction()

function(rawreel_apt_packages_doc_errors)
    cmake_parse_arguments(PARSE_ARGV 0 arg "" "ERRORS" "PACKAGES;DOCS")
    set(errors "")
    list(JOIN arg_PACKAGES " " packages)
    set(phrase "sudo apt install ${packages}")
    foreach(doc IN LISTS arg_DOCS)
        cmake_path(GET doc FILENAME name)
        if(NOT EXISTS "${doc}")
            list(APPEND errors "${name} is missing")
            continue()
        endif()
        file(READ "${doc}" text)
        string(FIND "${text}" "${phrase}" position)
        if(position EQUAL -1)
            list(APPEND errors "${name} does not say \"${phrase}\"")
        endif()
    endforeach()
    set(${arg_ERRORS} "${errors}" PARENT_SCOPE)
endfunction()

function(rawreel_check_pdb_reference)
    cmake_parse_arguments(PARSE_ARGV 0 arg "" "FILE;ERRORS" "")
    if(NOT EXISTS "${arg_FILE}")
        message(FATAL_ERROR "rawreel_check_pdb_reference: ${arg_FILE} does not exist")
    endif()
    # The CodeView record ends with the NUL-terminated PDB name after a 4-byte age, so the string
    # file(STRINGS) extracts is the name alone.
    file(STRINGS "${arg_FILE}" names REGEX "\\.[Pp][Dd][Bb]$")
    set(errors "")
    foreach(name IN LISTS names)
        if(name MATCHES "[/\\:]")
            list(APPEND errors "the exe names its PDB with a directory")
            break()
        endif()
    endforeach()
    set(${arg_ERRORS} "${errors}" PARENT_SCOPE)
endfunction()

function(rawreel_attestation_source)
    cmake_parse_arguments(PARSE_ARGV 0 arg "" "JSON;COMMIT;REF;ERRORS" "")
    set(errors "")
    set(prefix 0 verificationResult signature certificate)
    string(JSON digest ERROR_VARIABLE error GET "${arg_JSON}" ${prefix} sourceRepositoryDigest)
    string(LENGTH "${digest}" length)
    if(error OR NOT length EQUAL 40 OR NOT digest MATCHES "^[0-9a-f]+$")
        list(APPEND errors "attestation output has no sourceRepositoryDigest")
        set(digest "")
    endif()
    string(JSON ref ERROR_VARIABLE error GET "${arg_JSON}" ${prefix} sourceRepositoryRef)
    if(error OR ref STREQUAL "")
        list(APPEND errors "attestation output has no sourceRepositoryRef")
        set(ref "")
    endif()
    set(${arg_COMMIT} "${digest}" PARENT_SCOPE)
    set(${arg_REF} "${ref}" PARENT_SCOPE)
    set(${arg_ERRORS} "${errors}" PARENT_SCOPE)
endfunction()

function(rawreel_ffmpeg_version_line)
    cmake_parse_arguments(PARSE_ARGV 0 arg "" "TEXT;LINE;ERRORS" "")
    # Line by line through the encoded list: the not-available line holds a ';', which a
    # string(REGEX MATCHALL) result list would split into two items.
    _rawreel_text_lines("${arg_TEXT}" lines)
    set(found "")
    set(count 0)
    foreach(line IN LISTS lines)
        if(line MATCHES "^FFmpeg")
            _rawreel_line_decode("${line}" found)
            math(EXPR count "${count} + 1")
        endif()
    endforeach()
    set(errors "")
    if(NOT count EQUAL 1)
        list(APPEND errors "--version must print one line starting with FFmpeg, printed ${count}")
        set(found "")
    endif()
    set(${arg_LINE} "${found}" PARENT_SCOPE)
    set(${arg_ERRORS} "${errors}" PARENT_SCOPE)
endfunction()

function(rawreel_licence_supplements)
    cmake_parse_arguments(PARSE_ARGV 0 arg "" "DIR;PATHS;ERRORS" "SUPPLEMENTS")
    set(paths "")
    set(errors "")
    foreach(supplement IN LISTS arg_SUPPLEMENTS)
        if(NOT supplement MATCHES "^([^|]+)\\|([0-9a-f]+)$")
            list(APPEND errors "malformed supplement entry ${supplement}")
            continue()
        endif()
        set(path "${CMAKE_MATCH_1}")
        set(pin "${CMAKE_MATCH_2}")
        if(IS_ABSOLUTE "${path}" OR path MATCHES "(^|/)\\.\\.(/|$)|\\\\")
            list(APPEND errors "supplement path ${path} is not relative")
            continue()
        endif()
        if(NOT EXISTS "${arg_DIR}/${path}" OR IS_DIRECTORY "${arg_DIR}/${path}")
            list(APPEND errors "missing supplement ${path}")
            continue()
        endif()
        file(SHA256 "${arg_DIR}/${path}" actual)
        if(NOT actual STREQUAL pin)
            list(APPEND errors "supplement ${path} does not match its pin")
            continue()
        endif()
        list(APPEND paths "${path}")
    endforeach()
    set(${arg_PATHS} "${paths}" PARENT_SCOPE)
    set(${arg_ERRORS} "${errors}" PARENT_SCOPE)
endfunction()

function(rawreel_work_dir_errors)
    cmake_parse_arguments(PARSE_ARGV 0 arg "" "DIR;ERRORS" "PROTECT")
    set(errors "")
    cmake_path(ABSOLUTE_PATH arg_DIR NORMALIZE OUTPUT_VARIABLE dir)
    string(REGEX REPLACE "(.)[/]+$" "\\1" dir "${dir}")
    if(CMAKE_HOST_WIN32)
        string(TOLOWER "${dir}" dir)
    endif()
    cmake_path(GET dir RELATIVE_PART relative)
    if(relative STREQUAL "")
        list(APPEND errors "the work folder ${arg_DIR} is a filesystem root")
    endif()
    foreach(protect IN LISTS arg_PROTECT)
        cmake_path(ABSOLUTE_PATH protect NORMALIZE OUTPUT_VARIABLE path)
        if(CMAKE_HOST_WIN32)
            string(TOLOWER "${path}" path)
        endif()
        cmake_path(IS_PREFIX dir "${path}" NORMALIZE inside)
        if(inside)
            list(APPEND errors "the work folder ${arg_DIR} holds ${protect}")
        endif()
    endforeach()
    set(${arg_ERRORS} "${errors}" PARENT_SCOPE)
endfunction()

function(rawreel_package_files)
    cmake_parse_arguments(PARSE_ARGV 0 arg ""
                          "VERSION;PLATFORM;PACKAGE;SYMBOLS;CPACK;EXTENSION;GENERATOR;ERRORS" "")
    set(errors "")
    set(extension "")
    set(generator "")
    if(arg_PLATFORM STREQUAL "windows")
        set(extension zip)
        set(generator ZIP)
    elseif(arg_PLATFORM STREQUAL "linux")
        set(extension tar.xz)
        set(generator TXZ)
    else()
        list(APPEND errors "no package for the platform '${arg_PLATFORM}' (windows, linux)")
    endif()
    set(package "")
    set(symbols "")
    set(cpack "")
    if(NOT errors)
        set(package "rawreel-${arg_VERSION}-${arg_PLATFORM}-x64.${extension}")
        set(symbols "rawreel-${arg_VERSION}-${arg_PLATFORM}-x64-symbols.${extension}")
        set(cpack "rawreel-${arg_VERSION}.${extension}")
    endif()
    set(${arg_PACKAGE} "${package}" PARENT_SCOPE)
    set(${arg_SYMBOLS} "${symbols}" PARENT_SCOPE)
    set(${arg_CPACK} "${cpack}" PARENT_SCOPE)
    set(${arg_EXTENSION} "${extension}" PARENT_SCOPE)
    set(${arg_GENERATOR} "${generator}" PARENT_SCOPE)
    set(${arg_ERRORS} "${errors}" PARENT_SCOPE)
endfunction()

function(rawreel_ffmpeg_library_pattern)
    cmake_parse_arguments(PARSE_ARGV 0 arg "" "PLATFORM;LIBRARY;GLOB;REGEX" "")
    if(arg_PLATFORM STREQUAL "linux")
        set(glob "lib${arg_LIBRARY}.so.*")
        set(regex "/lib${arg_LIBRARY}\\.so\\.([0-9]+)$")
    else()
        set(glob "${arg_LIBRARY}-*.dll")
        set(regex "/${arg_LIBRARY}-([0-9]+)\\.dll$")
    endif()
    set(${arg_GLOB} "${glob}" PARENT_SCOPE)
    set(${arg_REGEX} "${regex}" PARENT_SCOPE)
endfunction()

function(rawreel_is_elf)
    cmake_parse_arguments(PARSE_ARGV 0 arg "" "FILE;RESULT" "")
    file(READ "${arg_FILE}" magic LIMIT 4 HEX)
    if(magic STREQUAL "7f454c46")
        set(${arg_RESULT} ON PARENT_SCOPE)
    else()
        set(${arg_RESULT} OFF PARENT_SCOPE)
    endif()
endfunction()

function(rawreel_readelf_dynamic)
    cmake_parse_arguments(PARSE_ARGV 0 arg "" "TEXT;NEEDED;SONAME;RUNPATH;RPATH" "")
    _rawreel_text_lines("${arg_TEXT}" lines)
    set(needed "")
    set(soname "")
    set(runpath "")
    set(rpath "")
    foreach(line IN LISTS lines)
        _rawreel_line_decode("${line}" line)
        if(line MATCHES "\\(NEEDED\\) +Shared library: \\[(.*)\\] *$")
            list(APPEND needed "${CMAKE_MATCH_1}")
        elseif(line MATCHES "\\(SONAME\\) +Library soname: \\[(.*)\\] *$")
            set(soname "${CMAKE_MATCH_1}")
        elseif(line MATCHES "\\(RUNPATH\\) +Library runpath: \\[(.*)\\] *$")
            set(runpath "${CMAKE_MATCH_1}")
        elseif(line MATCHES "\\(RPATH\\) +Library rpath: \\[(.*)\\] *$")
            set(rpath "${CMAKE_MATCH_1}")
        endif()
    endforeach()
    set(${arg_NEEDED} "${needed}" PARENT_SCOPE)
    set(${arg_SONAME} "${soname}" PARENT_SCOPE)
    set(${arg_RUNPATH} "${runpath}" PARENT_SCOPE)
    set(${arg_RPATH} "${rpath}" PARENT_SCOPE)
endfunction()

function(rawreel_readelf_max_versions)
    cmake_parse_arguments(PARSE_ARGV 0 arg "" "TEXT;GLIBC;GLIBCXX" "")
    foreach(prefix IN ITEMS GLIBC GLIBCXX)
        set(highest "")
        string(REGEX MATCHALL "${prefix}_[0-9]+(\\.[0-9]+)*" found "${arg_TEXT}")
        foreach(item IN LISTS found)
            string(REGEX REPLACE "^${prefix}_" "" version "${item}")
            if(highest STREQUAL "" OR version VERSION_GREATER highest)
                set(highest "${version}")
            endif()
        endforeach()
        set(${arg_${prefix}} "${highest}" PARENT_SCOPE)
    endforeach()
endfunction()

function(rawreel_elf_errors)
    cmake_parse_arguments(PARSE_ARGV 0 arg ""
                          "NAME;KIND;DYNAMIC;VERSIONS;GLIBC_MAX;GLIBCXX_MAX;ERRORS" "ALLOWED")
    rawreel_readelf_dynamic(TEXT "${arg_DYNAMIC}" NEEDED needed SONAME soname RUNPATH runpath
                            RPATH rpath)
    set(errors "")
    if(arg_KIND STREQUAL "exe")
        foreach(kind IN ITEMS RUNPATH RPATH)
            string(TOLOWER "${kind}" variable)
            if(NOT "${${variable}}" STREQUAL "")
                list(APPEND errors "${arg_NAME} has ${kind} ${${variable}} (the exes need none)")
            endif()
        endforeach()
        foreach(library IN LISTS needed)
            if(library MATCHES
               "^lib(avutil|avcodec|avformat|avfilter|avdevice|swscale|swresample|postproc)\\.so")
                string(CONCAT error "${arg_NAME} links the FFmpeg library ${library} (FFmpeg is "
                                    "loaded at run time)")
                list(APPEND errors "${error}")
            elseif(NOT library IN_LIST arg_ALLOWED)
                list(APPEND errors "${arg_NAME} needs ${library}, which is not in the system list")
            endif()
        endforeach()
    elseif(arg_KIND STREQUAL "library")
        if(NOT runpath STREQUAL "$ORIGIN")
            list(APPEND errors "${arg_NAME} has RUNPATH '${runpath}', expected exactly $ORIGIN")
        endif()
        if(NOT rpath STREQUAL "")
            list(APPEND errors "${arg_NAME} has RPATH ${rpath} (expected only RUNPATH $ORIGIN)")
        endif()
        if(soname STREQUAL "")
            list(APPEND errors "${arg_NAME} has no SONAME")
        elseif(NOT soname STREQUAL arg_NAME)
            list(APPEND errors "${arg_NAME} is not named by its SONAME ${soname}")
        endif()
    else()
        message(FATAL_ERROR "rawreel_elf_errors: KIND must be exe or library")
    endif()
    rawreel_readelf_max_versions(TEXT "${arg_VERSIONS}" GLIBC glibc GLIBCXX glibcxx)
    if(NOT glibc STREQUAL "" AND glibc VERSION_GREATER arg_GLIBC_MAX)
        list(APPEND errors "${arg_NAME} needs GLIBC_${glibc}, the baseline is ${arg_GLIBC_MAX}")
    endif()
    if(NOT glibcxx STREQUAL "" AND glibcxx VERSION_GREATER arg_GLIBCXX_MAX)
        list(APPEND errors "${arg_NAME} needs GLIBCXX_${glibcxx}, the baseline is ${arg_GLIBCXX_MAX}")
    endif()
    set(${arg_ERRORS} "${errors}" PARENT_SCOPE)
endfunction()

function(rawreel_ldd_errors)
    cmake_parse_arguments(PARSE_ARGV 0 arg "" "NAME;TEXT;ERRORS" "")
    _rawreel_text_lines("${arg_TEXT}" lines)
    set(errors "")
    foreach(line IN LISTS lines)
        _rawreel_line_decode("${line}" line)
        if(line MATCHES "^[ \t]*([^ \t]+) => not found")
            list(APPEND errors "${arg_NAME}: ldd finds no ${CMAKE_MATCH_1}")
        elseif(line MATCHES "not found")
            string(STRIP "${line}" line)
            list(APPEND errors "${arg_NAME}: ldd: ${line}")
        endif()
    endforeach()
    set(${arg_ERRORS} "${errors}" PARENT_SCOPE)
endfunction()

function(rawreel_linux_runtime_files)
    cmake_parse_arguments(PARSE_ARGV 0 arg "" "ROOT;FILES" "")
    file(GLOB_RECURSE files LIST_DIRECTORIES false RELATIVE "${arg_ROOT}" "${arg_ROOT}/*")
    set(found "")
    foreach(file IN LISTS files)
        cmake_path(GET file FILENAME name)
        if(name MATCHES "^(libstdc\\+\\+|libgcc_s|libc|libvulkan)(\\.so|-[0-9])")
            list(APPEND found "${file}")
        elseif(name MATCHES "\\.so(\\.[0-9]+)*$" AND NOT file MATCHES "^[^/]+/ffmpeg/[^/]+$")
            list(APPEND found "${file}")
        endif()
    endforeach()
    list(SORT found)
    set(${arg_FILES} "${found}" PARENT_SCOPE)
endfunction()

function(rawreel_readelf_build_id)
    cmake_parse_arguments(PARSE_ARGV 0 arg "" "TEXT;ID" "")
    set(id "")
    if(arg_TEXT MATCHES "Build ID: ([0-9a-f]+)")
        set(id "${CMAKE_MATCH_1}")
    endif()
    set(${arg_ID} "${id}" PARENT_SCOPE)
endfunction()

function(rawreel_readelf_debuglink)
    cmake_parse_arguments(PARSE_ARGV 0 arg "" "TEXT;NAME" "")
    _rawreel_text_lines("${arg_TEXT}" lines)
    set(name "")
    set(in_dump OFF)
    foreach(line IN LISTS lines)
        _rawreel_line_decode("${line}" line)
        if(line MATCHES "^String dump of section '\\.gnu_debuglink':")
            set(in_dump ON)
        elseif(in_dump AND line MATCHES "^ *\\[ *0\\] +([^ ]+)")
            set(name "${CMAKE_MATCH_1}")
            break()
        endif()
    endforeach()
    set(${arg_NAME} "${name}" PARENT_SCOPE)
endfunction()

function(rawreel_readelf_compressed_sections)
    cmake_parse_arguments(PARSE_ARGV 0 arg "" "TEXT;SECTIONS" "")
    _rawreel_text_lines("${arg_TEXT}" lines)
    set(sections "")
    # [Nr] Name Type Address Off Size ES Flg Lk Inf Al; Flg may be empty.
    set(hex "[0-9a-f]+")
    set(row "^ *\\[ *[0-9]+\\] +([^ ]+) +[A-Za-z0-9_]+ +${hex} +${hex} +${hex} +${hex} +")
    string(APPEND row "([A-Za-z]*) +[0-9]+ +[0-9]+ +[0-9]+ *$")
    foreach(line IN LISTS lines)
        _rawreel_line_decode("${line}" line)
        if(line MATCHES "${row}")
            set(section "${CMAKE_MATCH_1}")
            if(CMAKE_MATCH_2 MATCHES "C")
                list(APPEND sections "${section}")
            endif()
        endif()
    endforeach()
    set(${arg_SECTIONS} "${sections}" PARENT_SCOPE)
endfunction()

# Checks a GNU `tar tvf` listing (LC_ALL=C) of a Linux archive: only files and folders; the entries
# in EXECUTABLES have mode rwxr-xr-x and every other file rw-r--r--; no folder is world-writable.
# OWNER_NAMES returns the distinct owner/group pairs. With OWNERS or GROUPS given, any other owner
# or group name is an error (a CI build must not record a personal account).
#   rawreel_tar_listing_errors(TEXT <listing> [EXECUTABLES <entry>...] [OWNERS <name>...]
#                              [GROUPS <name>...] ERRORS <var> OWNER_NAMES <var>)
function(rawreel_tar_listing_errors)
    cmake_parse_arguments(PARSE_ARGV 0 arg "" "TEXT;ERRORS;OWNER_NAMES" "EXECUTABLES;OWNERS;GROUPS")
    _rawreel_text_lines("${arg_TEXT}" lines)
    set(errors "")
    set(owner_names "")
    set(owner_errors "")
    set(entries 0)
    # <type><mode> <owner>/<group> <size> <date> <time> <name>
    set(row "^([-dlbcps])([-rwxsStT]+) +([^/ ]+)/([^ ]+) +[0-9]+ +[0-9-]+ +[0-9:]+ +(.+)$")
    foreach(line IN LISTS lines)
        _rawreel_line_decode("${line}" line)
        if(line STREQUAL "")
            continue()
        endif()
        if(NOT line MATCHES "${row}")
            list(APPEND errors "cannot read the tar listing line: ${line}")
            continue()
        endif()
        math(EXPR entries "${entries} + 1")
        set(type "${CMAKE_MATCH_1}")
        set(mode "${CMAKE_MATCH_2}")
        set(owner "${CMAKE_MATCH_3}")
        set(group "${CMAKE_MATCH_4}")
        set(name "${CMAKE_MATCH_5}")
        list(APPEND owner_names "${owner}/${group}")
        if(arg_OWNERS AND NOT owner IN_LIST arg_OWNERS)
            list(JOIN arg_OWNERS ", " allowed)
            list(APPEND owner_errors "owner ${owner} is not allowed (allowed: ${allowed})")
        endif()
        if(arg_GROUPS AND NOT group IN_LIST arg_GROUPS)
            list(JOIN arg_GROUPS ", " allowed)
            list(APPEND owner_errors "group ${group} is not allowed (allowed: ${allowed})")
        endif()
        if(type STREQUAL "d")
            string(SUBSTRING "${mode}" 7 1 others_write)
            if(others_write STREQUAL "w")
                list(APPEND errors "${name}: world-writable folder (${mode})")
            endif()
        elseif(type STREQUAL "-")
            if(name IN_LIST arg_EXECUTABLES)
                set(expected "rwxr-xr-x")
            else()
                set(expected "rw-r--r--")
            endif()
            if(NOT mode STREQUAL expected)
                list(APPEND errors "${name}: mode ${mode}, expected ${expected}")
            endif()
        else()
            list(APPEND errors "${name}: entry type ${type} (only files and folders)")
        endif()
    endforeach()
    if(entries EQUAL 0 AND NOT errors)
        list(APPEND errors "the tar listing is empty")
    endif()
    list(REMOVE_DUPLICATES owner_names)
    list(REMOVE_DUPLICATES owner_errors)
    list(APPEND errors ${owner_errors})
    set(${arg_ERRORS} "${errors}" PARENT_SCOPE)
    set(${arg_OWNER_NAMES} "${owner_names}" PARENT_SCOPE)
endfunction()

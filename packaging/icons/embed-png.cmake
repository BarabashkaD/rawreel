# Writes a C++ source that embeds PNG files (app icon plan D7): one constexpr unsigned char array
# per file, named in UPPER_CASE after the file stem (owl-on-film-reel-square-background-16.png ->
# OWL_ON_FILM_REEL_SQUARE_BACKGROUND_16), 32 bytes per line, and the table
# rawreel::embeddedPngs() of {stem, bytes} in the order given (gui/app_icon_data.h).
# MSVC has no #embed, so this is how the bytes get into the binary.
# Run as cmake -DOUT=<app_icon_data.cpp> -DFILES=<a.png;b.png;...> -P embed-png.cmake.
# The output is written on every run; the build's add_custom_command reruns this script only when
# a listed PNG or the script changes. An empty list, an empty file or two files with the same stem
# stop the script, so no empty array or table is ever written.
cmake_minimum_required(VERSION 3.25)

if(NOT OUT)
    message(FATAL_ERROR "embed-png: OUT is required")
endif()
if(NOT FILES)
    message(FATAL_ERROR "embed-png: FILES is empty")
endif()

set(bytes_per_line 32)
math(EXPR hex_per_line "${bytes_per_line} * 2")

set(arrays "")
set(entries "")
set(stems "")
set(count 0)
foreach(png IN LISTS FILES)
    get_filename_component(stem "${png}" NAME_WE)
    get_filename_component(name "${png}" NAME)
    if(stem IN_LIST stems)
        message(FATAL_ERROR "embed-png: two files named '${stem}'")
    endif()
    list(APPEND stems "${stem}")
    string(TOUPPER "${stem}" symbol)
    string(REGEX REPLACE "[^A-Z0-9]" "_" symbol "${symbol}")
    if(NOT symbol MATCHES "^[A-Z]")
        message(FATAL_ERROR "embed-png: '${name}' does not start with a letter")
    endif()

    file(READ "${png}" hex HEX)
    string(LENGTH "${hex}" hex_length)
    if(hex_length EQUAL 0)
        message(FATAL_ERROR "embed-png: '${name}' is empty")
    endif()

    # Only the file name: the generated source holds no machine paths.
    string(APPEND arrays "// ${name}\nconstexpr unsigned char ${symbol}[] = {\n")
    set(offset 0)
    while(offset LESS hex_length)
        string(SUBSTRING "${hex}" ${offset} ${hex_per_line} line)
        string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1, " line "${line}")
        string(STRIP "${line}" line)
        string(APPEND arrays "    ${line}\n")
        math(EXPR offset "${offset} + ${hex_per_line}")
    endwhile()
    string(APPEND arrays "};\n\n")
    string(APPEND entries "    EmbeddedPng{.key = \"${stem}\", .png = ${symbol}},\n")
    math(EXPR count "${count} + 1")
endforeach()

file(WRITE "${OUT}" "// Generated by packaging/icons/embed-png.cmake (app icon plan D7). Do not edit.

#include \"gui/app_icon_data.h\"

#include <array>

namespace rawreel {

namespace {

${arrays}constexpr std::array<EmbeddedPng, ${count}> PNGS{
${entries}};

}  // namespace

std::span<const EmbeddedPng> embeddedPngs() {
    return PNGS;
}

}  // namespace rawreel
")
